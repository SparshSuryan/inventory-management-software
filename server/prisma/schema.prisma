generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  supplier  String?
  category_id    Int
  created_at     DateTime        @default(now())
  description    String?
  product_id     Int             @id @default(autoincrement())
  product_name   String
  sku            String          @unique
  unit_price     Float
  updated_at     DateTime        @updatedAt
  category       Category        @relation(fields: [category_id], references: [category_id])
  stock          Stock?
  stockAlerts    StockAlert[]
  stockMovements StockMovement[]
  receipts       Receipt[]
  inventoryTransfers InventoryTransfer[]
  issues         Issue[]
}

model Category {
  category_id   Int       @id @default(autoincrement())
  category_name String
  description   String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  products      Product[]
  transfersFrom InventoryTransfer[] @relation("FromCategory")
  transfersTo   InventoryTransfer[] @relation("ToCategory")
}

model Stock {
  stock_id       Int             @id @default(autoincrement())
  product_id     Int             @unique
  quantity       Int
  reorder_level  Int
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt
  product        Product         @relation(fields: [product_id], references: [product_id])
  stockAlerts    StockAlert[]
  stockMovements StockMovement[]
}

model User {
  user_id        Int             @id @default(autoincrement())
  name           String
  email          String          @unique
  password       String
  role           String
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt
  auditLogs      AuditLog[]
  stockMovements StockMovement[]
  receipts       Receipt[]
  inventoryTransfers InventoryTransfer[]
}

model StockMovement {
  movement_id   Int      @id @default(autoincrement())
  product_id    Int
  stock_id      Int
  movement_type String
  quantity      Int
  reference     String?
  created_by    Int?
  remarks       String?
  created_at    DateTime @default(now())
  user          User?     @relation(fields: [created_by], references: [user_id])
  product       Product  @relation(fields: [product_id], references: [product_id])
  stock         Stock    @relation(fields: [stock_id], references: [stock_id])
}

model StockAlert {
  alert_id         Int      @id @default(autoincrement())
  product_id       Int
  stock_id         Int
  current_quantity Int
  alert_type       String
  is_resolved      Boolean  @default(false)
  created_at       DateTime @default(now())
  product          Product  @relation(fields: [product_id], references: [product_id])
  stock            Stock    @relation(fields: [stock_id], references: [stock_id])
}

model AuditLog {
  log_id      Int      @id @default(autoincrement())
  user_id     Int
  action      String
  entity_type String
  entity_id   Int
  old_values  String?
  new_values  String?
  created_at  DateTime @default(now())
  user        User     @relation(fields: [user_id], references: [user_id])
}

model Receipt {
  receipt_id     Int      @id @default(autoincrement())
  receipt_number String   @unique
  product_id     Int
  supplier       String
  quantity       Int
  unit_cost      Float?
  total_cost     Float?
  received_date  DateTime @default(now())
  remarks        String?
  created_by     Int?
  created_at     DateTime @default(now())

  product Product @relation(fields: [product_id], references: [product_id])
  user    User?   @relation(fields: [created_by], references: [user_id])
}

model InventoryTransfer {
  transfer_id     Int      @id @default(autoincrement())
  transfer_number String   @unique
  product_id      Int
  from_category   Int
  to_category     Int
  quantity        Int
  remarks         String?
  created_by      Int?
  created_at      DateTime @default(now())

  product          Product  @relation(fields: [product_id], references: [product_id])
  fromCategory     Category @relation("FromCategory", fields: [from_category], references: [category_id])
  toCategory       Category @relation("ToCategory", fields: [to_category], references: [category_id])
  user             User?    @relation(fields: [created_by], references: [user_id])
}

model Issue {
  issue_id     Int      @id @default(autoincrement())
  issue_number String   @unique
  product_id   Int
  issue_type   String   // LOW_STOCK, OUT_OF_STOCK, SURPLUS_STOCK, DAMAGED_STOCK
  stage        String   // Raw Material, Work In Progress, Finished Product
  description  String?
  status       String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED
  resolved_at  DateTime?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  product Product @relation(fields: [product_id], references: [product_id])
}